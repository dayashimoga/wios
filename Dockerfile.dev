FROM ubuntu:26.04 AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Install system dependencies in a single layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git ca-certificates build-essential pkg-config \
    libssl-dev libclang-dev cmake ninja-build \
    libgtk-3-dev libblkid-dev liblzma-dev \
    protobuf-compiler unzip zip xz-utils wget \
    clang lld sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# ── Rust ────────────────────────────────────────────────────────
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH="/usr/local/cargo/bin:${PATH}"

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable \
    && rustup component add clippy rustfmt \
    && cargo install cargo-tarpaulin --locked \
    && rm -rf /usr/local/cargo/registry/cache

# ── Flutter ─────────────────────────────────────────────────────
ENV FLUTTER_HOME=/usr/local/flutter
ENV PATH="${FLUTTER_HOME}/bin:${FLUTTER_HOME}/bin/cache/dart-sdk/bin:${PATH}"

RUN git clone https://github.com/flutter/flutter.git ${FLUTTER_HOME} --branch stable --depth 1 \
    && flutter precache --web --linux \
    && flutter config --no-analytics \
    && dart pub global activate melos

ENV PATH="/root/.pub-cache/bin:${PATH}"

# ── Verify ──────────────────────────────────────────────────────
RUN rustc --version && cargo --version && flutter --version && melos --version

WORKDIR /workspace
