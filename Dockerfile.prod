FROM rust:1.87-bookworm AS rust-builder
WORKDIR /build
COPY crates/ crates/
RUN cd crates && cargo build --workspace --release

FROM ubuntu:26.04 AS flutter-builder
RUN apt-get update && apt-get install -y curl git unzip xz-utils && \
    git clone --depth 1 -b stable https://github.com/flutter/flutter.git /flutter && \
    /flutter/bin/flutter precache --web
ENV PATH="/flutter/bin:$PATH"
WORKDIR /build
COPY . .
RUN flutter build web --release --dart-define=FLUTTER_WEB_USE_SKIA=true
WORKDIR /build/apps/wios_app

FROM nginx:alpine AS production
COPY --from=flutter-builder /build/apps/wios_app/build/web /usr/share/nginx/html
COPY --from=rust-builder /build/crates/target/release/libwios_bridge.so /usr/local/lib/
RUN echo 'server { \
  listen 80; \
  root /usr/share/nginx/html; \
  index index.html; \
  location / { try_files $uri $uri/ /index.html; } \
  location /api/ { proxy_pass http://localhost:3000; } \
  gzip on; \
  gzip_types text/plain text/css application/json application/javascript; \
}' > /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
